NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://USER@localhost:5432/loyalty_dev

# Signing key for merchant access tokens. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Odoo (Golalita merchant backend). Used server-side to verify merchant tokens and read branches.
ODOO_BASE_URL=https://www.golalita.com/go/api
ODOO_TIMEOUT_MS=8000

# Comma-separated origins allowed to call the API from a browser (the sign-up website).
CORS_ORIGINS=http://localhost:5173

# Base URL printed in branch QR codes.
PUBLIC_JOIN_BASE_URL=https://join.golalita.com
